# 从 https://platform.deepseek.com 获取，不要把真实密钥提交到仓库。
DEEPSEEK_API_KEY=sk-your-key-here

# 第一版默认使用速度和成本更适合客服场景的 V4 Flash。
# 如需更强能力，可改为 deepseek-v4-pro。
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# RAG：检索 knowledge/ 下的 .md / .txt 业务文档。
# 知识库变更后先运行 python index.py，再启动 main.py。
RAG_KNOWLEDGE_DIR=knowledge
RAG_INDEX_DIR=.rag_index
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 国内访问 Hugging Face 超时可使用镜像；首次下载 embedding 模型时生效。
HF_ENDPOINT=https://hf-mirror.com
# 模型已在本地缓存时可设为 1。cli/main 会在导入 huggingface 库之前加载本文件，
# 否则仅写在这里也会因 import 时机过晚而不生效。
# HF_HUB_OFFLINE=1
